{
  "name": "Podnook",
  "id": "com.podnook.app",
  "version": "0.1.0",
  "build": 1,
  "icon": "assets/icon.png",
  "rust": ".",
  "root": "App",
  "appearance": "system",
  "locales": ["en", "zh"],
  "macos": {
    "activationPolicy": "accessory"
  },
  "window": {
    "title": "Podnook",
    "defaultSize": {
      "width": 980,
      "height": 640
    },
    "minSize": {
      "width": 720,
      "height": 480
    },
    "frame": "none",
    "transparent": true,
    "shadow": true,
    "level": "floating",
    "closeOnPress": false,
    "activate": true,
    "focusable": true
  },
  "capabilities": {
    "windows": true,
    "statusBar": true
  }
}
